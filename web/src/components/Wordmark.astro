---
// Temporary text wordmark. When an official logo is uploaded in
// Site settings → Branding, it replaces this automatically.
import {imageUrl, type SanityImage} from '../lib/image'
interface Props {
  logo?: SanityImage
  edition?: string
  year?: string
  dark?: boolean
}
const {logo, edition = '10th', year = '2026', dark = false} = Astro.props
---
{
  logo?.asset ? (
    <img src={imageUrl(logo, 360)} alt={logo.alt || `WIRE ${year}`} class="h-9 w-auto sm:h-11" height="44" />
  ) : (
    <span class:list={['inline-flex items-baseline gap-2.5 leading-none', dark ? 'text-white' : 'text-ink']}>
      <span class="text-xl font-semibold tracking-[-0.03em] sm:text-2xl">WIRE</span>
      <span class:list={['text-[0.8rem] sm:text-sm', dark ? 'text-white/70' : 'text-muted']}>{edition} edition · Nairobi {year}</span>
    </span>
  )
}
