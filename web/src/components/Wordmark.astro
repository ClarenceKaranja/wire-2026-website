---
// Temporary text wordmark. When an official logo is uploaded in
// Site settings → Branding, it replaces this automatically.
import {imageUrl, type SanityImage} from '../lib/image'
interface Props {
  logo?: SanityImage
  edition?: string
  year?: string
  dark?: boolean
}
const {logo, edition = '10th', year = '2026', dark = false} = Astro.props
---
{
  logo?.asset ? (
    <img src={imageUrl(logo, 360)} alt={logo.alt || `WIRE ${year}`} class="h-10 w-auto sm:h-12" height="48" />
  ) : (
    <span class:list={['inline-flex items-center gap-3 font-display leading-none', dark ? 'text-white' : 'text-ink']}>
      <span class="text-[1.65rem] font-extrabold tracking-tight sm:text-3xl">WIRE</span>
      <span class:list={['border-l pl-3 text-[0.68rem] font-semibold tracking-[0.12em] uppercase sm:text-xs', dark ? 'border-white/40 text-white/85' : 'border-line text-muted']}>
        {edition} Forum
        <span class="mt-1 block">Nairobi {year}</span>
      </span>
    </span>
  )
}
