---
import Icon from './Icon.astro'
interface Props {
  icon?: 'image' | 'file' | 'bell' | 'calendar' | 'info'
  title: string
}
const {icon = 'info', title} = Astro.props
---
<div class="py-10">
  <Icon name={icon} class="size-6 text-muted" />
  <p class="mt-5 text-2xl font-medium tracking-tight text-ink">{title}</p>
  <div class="mt-2 max-w-xl text-ink-soft"><slot /></div>
</div>
