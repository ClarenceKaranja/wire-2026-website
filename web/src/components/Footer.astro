---
import {formatRange} from '../lib/time'
import type {Settings} from '../lib/content'
interface Props {
  settings: Settings
}
const {settings} = Astro.props
const year = settings.startDate?.slice(0, 4)
const links = [
  {href: '/agenda', label: 'Agenda'},
  {href: '/participant-information', label: 'Participant information'},
  {href: '/downloads', label: 'Downloads'},
  {href: '/gallery', label: 'Photo gallery'},
  {href: '/announcements', label: 'Announcements'},
  {href: '/about', label: 'About WIRE'},
]
---
<footer class="on-dark mt-28 bg-ink text-white/75 sm:mt-36">
  <div class="container-page pt-16 pb-10 sm:pt-20">
    <div class="grid gap-12 md:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <p class="text-5xl font-medium tracking-[-0.045em] text-white sm:text-6xl">WIRE</p>
        <p class="mt-4 text-white">{settings.edition} {settings.eventName}</p>
        <p class="mt-1 text-sm">{formatRange(settings.startDate, settings.endDate)} · {settings.city}, {settings.country}</p>
        {settings.organizerLine && <p class="mt-6 max-w-md text-sm leading-relaxed">{settings.organizerLine}</p>}
      </div>
      <nav aria-label="Footer">
        <h2 class="text-xs font-medium tracking-[0.16em] text-white/60 uppercase">Explore</h2>
        <ul class="mt-5 space-y-2.5 text-[0.95rem]">
          {links.map((l) => <li><a class="text-white no-underline hover:text-un hover:underline" href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="text-xs font-medium tracking-[0.16em] text-white/60 uppercase">Contact</h2>
        <p class="mt-5 text-[0.95rem]">WIRE Organizing Committee</p>
        <a class="mt-1 inline-block text-[0.95rem] break-all text-white hover:text-un" href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>
      </div>
    </div>
    <div class="mt-16 flex flex-col gap-2 border-t border-white/15 pt-6 text-xs text-white/60 sm:flex-row sm:justify-between">
      <p>{settings.footerNote}</p>
      <p class="shrink-0">© {year} WIRE</p>
    </div>
  </div>
</footer>
