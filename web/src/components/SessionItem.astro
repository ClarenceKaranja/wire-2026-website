---
import Icon from './Icon.astro'
import RichText from './RichText.astro'
import {SESSION_TYPE_LABELS} from '../lib/format'
import {nairobiInstant} from '../lib/time'
interface Props {
  session: any
  date: string
  restrictedNote?: string
}
const {session: s, date, restrictedNote} = Astro.props
const light = ['break', 'meal', 'registration'].includes(s.sessionType)
const restricted = s.sessionType === 'restricted'
const cancelled = s.status === 'cancelled'
const people = (list: any[] | null | undefined) =>
  (list ?? []).map((p) => [p.name, [p.position, p.organization].filter(Boolean).join(', ')].filter(Boolean).join(' · '))
const moderators = people(s.moderators)
const speakers = people(s.speakers)
---
<li
  class:list={['session relative grid gap-x-6 gap-y-1 border-b border-line py-6 sm:grid-cols-[10rem_1fr]', light && 'py-4', cancelled && 'opacity-70']}
  data-start={nairobiInstant(date, s.startTime)}
  data-end={nairobiInstant(date, s.endTime ?? s.startTime)}
>
  <p class="text-base tabular-nums text-ink">
    <time datetime={nairobiInstant(date, s.startTime)}>{s.startTime}</time>
    {s.endTime && <>
      <span aria-hidden="true">–</span><span class="sr-only"> to </span>
      <time datetime={nairobiInstant(date, s.endTime)}>{s.endTime}</time>
    </>}
  </p>
  <div>
    <div class="flex flex-wrap items-center gap-2">
      {!light && (
        <span class:list={['tag', restricted ? 'bg-sand text-ink-soft' : 'bg-brand-50 text-ink']}>
          {restricted && <Icon name="lock" class="size-3.5" />}
          {SESSION_TYPE_LABELS[s.sessionType] ?? 'Session'}
        </span>
      )}
      {s.hybrid && <span class="tag border border-line text-ink"><Icon name="video" class="size-3.5" />Hybrid</span>}
      {s.status === 'tbc' && <span class="tag bg-amber-soft text-amber-ink">Details to be confirmed</span>}
      {s.status === 'changed' && <span class="tag bg-amber-soft text-amber-ink">Changed{s.changeNote ? `: ${s.changeNote}` : ''}</span>}
      {cancelled && <span class="tag bg-alert-soft text-alert">Cancelled</span>}
      <span class="hidden tag bg-un text-ink" data-now-badge>Happening now</span>
    </div>
    <h3 class:list={['mt-1.5 leading-snug', light ? 'text-base font-normal text-muted' : 'text-xl font-medium tracking-tight', cancelled && 'line-through']}>
      {light && <Icon name={s.sessionType === 'registration' ? 'users' : 'coffee'} class="mr-1.5 inline size-4 -translate-y-px text-muted" />}
      {s.title}
    </h3>
    {s.subtitle && <p class="mt-0.5 text-ink-soft">{s.subtitle}</p>}
    {restricted && restrictedNote ? <p class="mt-2 max-w-2xl text-[0.95rem] text-muted">{restrictedNote}</p> : <RichText value={s.description} class="mt-2 max-w-2xl text-[0.95rem]" />}
    {(moderators.length > 0 || speakers.length > 0) && (
      <dl class="mt-3 grid gap-1 text-[0.95rem]">
        {moderators.length > 0 && <div class="flex gap-2"><dt class="font-semibold">Moderator{moderators.length > 1 && 's'}:</dt><dd>{moderators.join('; ')}</dd></div>}
        {speakers.length > 0 && <div class="flex gap-2"><dt class="font-semibold">Speaker{speakers.length > 1 && 's'}:</dt><dd>{speakers.join('; ')}</dd></div>}
      </dl>
    )}
    {!restricted && s.location && (
      <p class="mt-2 inline-flex items-center gap-1.5 text-sm text-muted"><Icon name="pin" class="size-4" />{s.location}</p>
    )}
  </div>
</li>
