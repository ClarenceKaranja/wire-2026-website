---
const {node} = Astro.props as {node: {markDef?: {href?: string}}}
const href = node?.markDef?.href ?? '#'
const external = /^https?:\/\//.test(href)
---
<a href={href} {...(external ? {rel: 'noopener', target: '_blank'} : {})}><slot />{external && <span class="sr-only"> (opens in a new tab)</span>}</a>
