---
import Wordmark from './Wordmark.astro'
import Icon from './Icon.astro'
import type {Settings} from '../lib/content'
interface Props {
  settings: Settings
}
const {settings} = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const nav: {href: string; label: string; short?: string}[] = [
  {href: '/', label: 'Home'},
  {href: '/programme', label: 'Programme'},
  {href: '/participant-information', label: 'Participant information', short: 'Participants'},
  {href: '/resources', label: 'Resources'},
  {href: '/gallery', label: 'Gallery'},
  {href: '/announcements', label: 'Announcements'},
  {href: '/about', label: 'About WIRE', short: 'About'},
]
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`))
const year = settings.startDate?.slice(0, 4)
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/80">
  <div class="container-page flex items-center justify-between gap-6 py-4 sm:py-5">
    <a href="/" class="inline-flex min-h-11 items-center no-underline" aria-label={`${settings.shortTitle} home`}>
      <Wordmark logo={settings.logo} edition={settings.edition} year={year} />
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {nav.slice(1).map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'relative block py-2 text-[0.9rem] no-underline after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:origin-left after:bg-un after:transition-transform after:duration-300',
                isCurrent(item.href) ? 'text-ink after:scale-x-100' : 'text-ink-soft after:scale-x-0 hover:text-ink hover:after:scale-x-100',
              ]}
            >
              {item.short ?? item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      type="button"
      class="inline-flex items-center gap-2 py-2 text-sm font-medium text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <Icon name="menu" class="size-5" />
      <span data-menu-label>Menu</span>
    </button>
  </div>
  <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-line bg-paper lg:hidden" data-menu>
    <ul class="container-page divide-y divide-line py-2">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={['flex items-center justify-between py-4 text-xl font-medium tracking-tight no-underline', isCurrent(item.href) ? 'text-brand-700' : 'text-ink']}
          >
            {item.label}
            <Icon name="chevronRight" class="size-4 text-muted" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')
  const label = document.querySelector<HTMLElement>('[data-menu-label]')
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open))
    menu?.classList.toggle('hidden', !open)
    if (label) label.textContent = open ? 'Close' : 'Menu'
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false)
      toggle.focus()
    }
  })
</script>
