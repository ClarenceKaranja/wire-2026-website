---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import RichText from '../components/RichText.astro'
import Icon from '../components/Icon.astro'
import EmptyState from '../components/EmptyState.astro'
import {fetchContent, getSettings, Q} from '../lib/content'

const preview = Astro.locals.preview
const [settings, data] = await Promise.all([getSettings(preview), fetchContent<any>(Q.INFO_QUERY, preview)])
const sections: any[] = data.sections ?? []
const faqs: any[] = data.faqs ?? []
const topics = [...new Set(faqs.map((f) => f.topic || 'General'))]
const contacts = settings.contacts?.length ? settings.contacts : [{_key: 'main', label: 'General enquiries', email: settings.contactEmail}]
---
<Base title="Participant information" description="Venue, travel, Kenya eTA, airport arrival, accommodation, Nairobi National Park visit, meals, FAQs and contacts for WIRE participants.">
  <PageHeader eyebrow="Participants" title="Participant information" lead={data.page?.intro} />
  <div class="container-page grid gap-12 pt-12 pb-10 sm:pt-16 lg:grid-cols-[15rem_1fr]">
    <nav aria-label="On this page" class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="eyebrow">On this page</h2>
      <ul class="mt-3 space-y-1 border-l border-line text-[0.95rem]">
        {sections.map((s) => (
          <li><a href={`#${s.slug}`} class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-ink-soft no-underline hover:border-brand-800 hover:text-brand-800">{s.title}</a></li>
        ))}
        {faqs.length > 0 && <li><a href="#faq" class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-ink-soft no-underline hover:border-brand-800 hover:text-brand-800">Frequently asked questions</a></li>}
        <li><a href="#contacts" class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-ink-soft no-underline hover:border-brand-800 hover:text-brand-800">Contacts</a></li>
      </ul>
    </nav>
    <div class="min-w-0">
      {sections.length === 0 && <EmptyState title="Information will be published soon">Contact <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a> with any questions.</EmptyState>}
      {sections.map((s, i) => (
        <section id={s.slug} class:list={['max-w-3xl', i > 0 && 'mt-12 border-t border-line pt-12']}>
          <h2 class="flex flex-wrap items-center gap-3 text-3xl font-medium tracking-tight">
            {s.title}
            {s.toBeConfirmed && <span class="tag bg-amber-soft font-sans text-amber-ink">Details to be confirmed</span>}
          </h2>
          <RichText value={s.body} class="mt-4" />
        </section>
      ))}

      {faqs.length > 0 && (
        <section id="faq" class="mt-12 max-w-3xl border-t border-line pt-12">
          <h2 class="text-3xl font-medium tracking-tight">Frequently asked questions</h2>
          {topics.map((topic) => (
            <div class="mt-8">
              <h3 class="eyebrow">{topic}</h3>
              <div class="mt-3 divide-y divide-line border-y border-line">
                {faqs.filter((f) => (f.topic || 'General') === topic).map((f) => (
                  <details class="group py-1">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-display font-medium text-ink [&::-webkit-details-marker]:hidden">
                      {f.question}
                      <Icon name="chevronDown" class="size-5 shrink-0 text-brand-800 transition-transform group-open:rotate-180" />
                    </summary>
                    <RichText value={f.answer} class="pb-4" />
                  </details>
                ))}
              </div>
            </div>
          ))}
        </section>
      )}

      <section id="contacts" class="mt-12 max-w-3xl border-t border-line pt-12">
        <h2 class="text-3xl font-medium tracking-tight">Contacts</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {contacts.map((c) => (
            <li class="border border-line bg-white p-5">
              <p class="eyebrow">{c.label}</p>
              {c.name && <p class="mt-2 font-semibold">{c.name}</p>}
              {c.email && <p class="mt-1"><a href={`mailto:${c.email}`} class="inline-flex items-center gap-2"><Icon name="mail" class="size-4" />{c.email}</a></p>}
              {c.phone && <p class="mt-1"><a href={`tel:${c.phone.replace(/\s+/g, '')}`}>{c.phone}</a></p>}
              {c.note && <p class="mt-2 text-sm text-muted">{c.note}</p>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>
