---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import RichText from '../components/RichText.astro'
import {fetchContent, Q} from '../lib/content'
import {imageUrl} from '../lib/image'

const data = await fetchContent<any>(Q.ABOUT_QUERY, Astro.locals.preview)
const page = data.page ?? {}
const partners: any[] = data.partners ?? []
const organizers = partners.filter((p) => p.role === 'organizer' || p.role === 'host')
const others = partners.filter((p) => p.role !== 'organizer' && p.role !== 'host')
const roleLabel: Record<string, string> = {organizer: 'Organizer', host: 'In collaboration with', funder: 'Funding partner', partner: 'Partner'}
---
<Base title="About WIRE" description="About the Wildlife Inter-Regional Enforcement (WIRE) Forum, its objectives and organizers.">
  <PageHeader eyebrow="About" title="About the WIRE Forum" />
  <div class="container-page grid gap-12 pt-12 pb-10 sm:pt-16 lg:grid-cols-[1fr_22rem]">
    <div class="max-w-3xl">
      <RichText value={page.intro} class="text-lg" />
      {page.objectives?.length > 0 && (
        <section class="mt-14">
          <h2 class="text-3xl font-medium tracking-tight">Objectives</h2>
          <ol class="mt-6 grid border-t border-ink sm:grid-cols-2 sm:gap-x-10">
            {page.objectives.map((o: string, i: number) => (
              <li class="flex gap-4 border-b border-line py-5">
                <span class="text-sm text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-lg leading-snug">{o}</span>
              </li>
            ))}
          </ol>
        </section>
      )}
      <RichText value={page.body} class="mt-6" />
    </div>
    <aside class="lg:pt-2">
      <section class="border-t border-ink pt-6">
        <h2 class="eyebrow">Organizers</h2>
        <RichText value={page.organizersText} class="mt-3 text-[0.95rem]" />
        {organizers.length > 0 && (
          <ul class="mt-5 space-y-4 border-t border-line pt-5">
            {organizers.map((p) => (
              <li>
                <p class="eyebrow">{roleLabel[p.role]}</p>
                {p.logo?.asset && <img src={imageUrl(p.logo, 320)} alt={p.logo.alt || p.name} class="mt-2 h-12 w-auto" loading="lazy" />}
                <p class="mt-1 text-lg font-medium">{p.url ? <a href={p.url} rel="noopener" target="_blank">{p.name}<span class="sr-only"> (opens in a new tab)</span></a> : p.name}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
      {others.length > 0 && (
        <section class="mt-12 border-t border-ink pt-6">
          <h2 class="eyebrow">With the support of</h2>
          <ul class="mt-4 space-y-4">
            {others.map((p) => (
              <li>
                {p.logo?.asset && <img src={imageUrl(p.logo, 320)} alt={p.logo.alt || p.name} class="h-10 w-auto" loading="lazy" />}
                <p class="mt-1 font-semibold">{p.acknowledgement || p.name}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</Base>
