---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import RichText from '../components/RichText.astro'
import {fetchContent, getSettings, Q} from '../lib/content'
import {imageSrcSet, imageUrl} from '../lib/image'
import {formatDateTime, formatRange, resolvePhase} from '../lib/time'

const preview = Astro.locals.preview
const [settings, data] = await Promise.all([getSettings(preview), fetchContent<any>(Q.HOME_QUERY, preview)])
const home = data.home ?? {}
const phase = resolvePhase(settings.eventPhase, settings.startDate, settings.endDate)
const dates = formatRange(settings.startDate, settings.endDate)
const place = [settings.venueName, settings.city, settings.country].filter(Boolean).join(', ')
const hero = home.heroImage
const latest = data.latest
const status = {before: 'Upcoming', during: 'Taking place now', after: 'Held'}[phase]

// The homepage is a simple index: each section of the site, one line each.
const sections = [
  {href: '/programme', title: 'Programme', text: 'Four days of sessions, in Nairobi time'},
  phase === 'after'
    ? {href: '/gallery', title: 'Photo gallery', text: 'Approved photographs from WIRE'}
    : {href: '/participant-information', title: 'Participant information', text: 'Venue, travel, eTA, accommodation and FAQs'},
  {href: '/resources', title: 'Resources', text: 'Agenda, information and logistics notes'},
  {href: '/announcements', title: 'Announcements', text: 'Latest updates for participants'},
  phase === 'after'
    ? {href: '/participant-information', title: 'Participant information', text: 'Practical information for WIRE'}
    : {href: '/gallery', title: 'Photo gallery', text: 'Photographs from WIRE'},
  {href: '/about', title: 'About WIRE', text: 'WIRE, its organizers and partners'},
]
---
<Base>
  <section class="container-page pt-14 pb-16 sm:pt-24 sm:pb-24 lg:pt-32">
    <p class="eyebrow animate-rise">{settings.edition} {settings.eventName}</p>
    <h1 class="mt-6 animate-rise text-[clamp(5rem,27vw,9rem)] sm:text-[clamp(6rem,15vw,13.5rem)] leading-[0.86] font-medium tracking-[-0.055em] [animation-delay:80ms]">
      WIRE
    </h1>
    <div class="mt-10 h-1.5 w-24 animate-rise bg-un [animation-delay:160ms] sm:mt-14" aria-hidden="true"></div>
    <dl class="mt-8 grid max-w-4xl animate-rise gap-6 [animation-delay:200ms] sm:grid-cols-3">
      <div>
        <dt class="eyebrow">Dates</dt>
        <dd class="mt-1.5 text-lg">{dates}</dd>
      </div>
      <div>
        <dt class="eyebrow">Place</dt>
        <dd class="mt-1.5 text-lg">{place}</dd>
      </div>
      <div>
        <dt class="eyebrow">Status</dt>
        <dd class="mt-1.5 text-lg">{status}</dd>
      </div>
    </dl>
    {home.heroLead && <p class="mt-10 max-w-2xl animate-rise text-xl leading-relaxed text-ink-soft [animation-delay:240ms] sm:text-2xl sm:leading-snug">{home.heroLead}</p>}
  </section>

  {hero?.asset && (
    <figure class="container-page">
      <img
        src={imageUrl(hero, 1600, 686)}
        srcset={imageSrcSet(hero, [640, 960, 1280, 1600, 2200], 1600 / 686)}
        sizes="(min-width: 1280px) 76rem, 100vw"
        alt={hero.alt ?? ''}
        width="1600"
        height="686"
        fetchpriority="high"
        class="aspect-[4/3] w-full object-cover sm:aspect-[1600/686]"
      />
      {hero.credit && <figcaption class="mt-2 text-xs text-muted">Photo: {hero.credit}</figcaption>}
    </figure>
  )}

  {phase === 'after' && home.outcomesSummary?.length > 0 && (
    <section class="container-page mt-20 grid gap-6 md:grid-cols-[16rem_1fr]">
      <h2 class="eyebrow">{home.outcomesHeading || 'Outcomes of WIRE'}</h2>
      <RichText value={home.outcomesSummary} class="max-w-3xl text-xl" />
    </section>
  )}

  <nav aria-labelledby="explore" class="container-page mt-20 sm:mt-28">
    <h2 id="explore" class="eyebrow">Explore</h2>
    <ul class="mt-5 border-t border-ink">
      {sections.map((s, i) => (
        <li class="border-b border-line">
          <a href={s.href} class="group grid grid-cols-[2.25rem_1fr_auto] items-baseline gap-x-4 py-6 no-underline sm:grid-cols-[4rem_1fr_1fr_auto] sm:py-8">
            <span class="text-sm text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-2xl font-medium tracking-tight text-ink transition-colors group-hover:text-brand-700 sm:text-4xl">{s.title}</span>
            <span class="col-start-2 mt-1 text-muted sm:col-start-3 sm:mt-0">{s.text}</span>
            <Icon name="arrow" class="col-start-3 row-start-1 size-6 self-center text-ink transition-transform duration-300 group-hover:translate-x-1.5 group-hover:text-brand-700 sm:col-start-4" />
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {latest && (
    <section aria-labelledby="latest" class="container-page mt-20">
      <div class="flex flex-col gap-3 bg-sand p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:p-8">
        <div>
          <h2 id="latest" class="eyebrow">Latest announcement · <time datetime={latest.publishedAt}>{formatDateTime(latest.publishedAt, false)}</time></h2>
          <p class="mt-2 text-lg font-medium">{latest.title}</p>
        </div>
        <a href={`/announcements#announcement-${latest._id}`} class="btn-quiet shrink-0 self-start sm:self-center">Read<Icon name="arrow" class="size-4" /></a>
      </div>
    </section>
  )}
</Base>
