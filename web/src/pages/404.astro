---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
export const prerender = false
Astro.response.status = 404
---
<Base title="Page not found" noindex>
  <section class="container-page py-20 sm:py-28">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">This page could not be found</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-soft">
      The link may be out of date, or the page may have been moved. Most participant information is available from the pages below.
    </p>
    <ul class="mt-8 grid max-w-2xl gap-3 sm:grid-cols-2">
      {[
        ['/', 'Homepage'],
        ['/programme', 'Programme'],
        ['/participant-information', 'Participant information'],
        ['/resources', 'Resources and downloads'],
      ].map(([href, label]) => (
        <li>
          <a href={href} class="flex items-center justify-between rounded-sm border border-line bg-white px-5 py-4 font-display font-bold no-underline hover:border-forest-800">
            {label}<Icon name="arrow" class="size-5" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
