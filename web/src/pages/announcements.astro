---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import AnnouncementCard from '../components/AnnouncementCard.astro'
import EmptyState from '../components/EmptyState.astro'
import Icon from '../components/Icon.astro'
import {fetchContent, Q} from '../lib/content'

const items = await fetchContent<any[]>(Q.ANNOUNCEMENTS_QUERY, Astro.locals.preview)
const now = Date.now()
const current = items.filter((a) => !a.expiresAt || Date.parse(a.expiresAt) > now).sort((a, b) => Number(b.featured) - Number(a.featured))
const past = items.filter((a) => a.expiresAt && Date.parse(a.expiresAt) <= now)
---
<Base title="Announcements" description="Programme changes, transport reminders and practical notices for WIRE participants.">
  <PageHeader eyebrow="Announcements" title="Announcements" lead="Programme changes, transport reminders, room changes and other practical notices. The newest are shown first." />
  <div class="container-page pt-12 pb-10 sm:pt-16"><div class="max-w-4xl">
    {current.length === 0 ? (
      <EmptyState icon="bell" title="No current announcements">Important updates for participants will be posted here.</EmptyState>
    ) : (
      <div class="space-y-4">{current.map((a) => <AnnouncementCard item={a} headingLevel="h2" />)}</div>
    )}
    {past.length > 0 && (
      <details class="group mt-12 border border-line bg-white px-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-display font-medium [&::-webkit-details-marker]:hidden">
          Past announcements ({past.length})
          <Icon name="chevronDown" class="size-5 text-brand-800 transition-transform group-open:rotate-180" />
        </summary>
        <div class="space-y-4 pb-5">{past.map((a) => <AnnouncementCard item={a} />)}</div>
      </details>
    )}
  </div></div>
</Base>
