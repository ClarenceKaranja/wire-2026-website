---
// French and Portuguese versions: /participant-information/fr and /participant-information/pt
import ParticipantInfo from '../../components/ParticipantInfo.astro'
import {isLang} from '../../lib/i18n'

const {lang} = Astro.params
if (!isLang(lang) || lang === 'en') return Astro.rewrite('/404')
---
<ParticipantInfo lang={lang} />
