# Copy this file to web/.env for local development. Never commit the real .env.
# In Netlify, set the same names under Site configuration > Environment variables.

# --- Public values (safe to appear in the browser) ---
# Sanity project and dataset. Leave PUBLIC_SANITY_PROJECT_ID empty locally to use the sample content in seed/.
PUBLIC_SANITY_PROJECT_ID=krb5nty9
PUBLIC_SANITY_DATASET=production
# Address of the hosted Sanity Studio, e.g. https://wire-2026.sanity.studio
PUBLIC_SANITY_STUDIO_URL=
# Final public address of the website, e.g. https://www.example.org (used for the sitemap and share links)
PUBLIC_SITE_URL=

# --- Server-only secrets (NEVER prefix with PUBLIC_, never put in client code or git) ---
# Sanity API token with the "Viewer" role only. Used for editor previews of drafts.
SANITY_API_READ_TOKEN=
# Shared secret for the optional Sanity webhook that refreshes the site instantly after publishing.
SANITY_WEBHOOK_SECRET=
# Random string of 32+ characters used to sign the preview cookie. Generate with: openssl rand -hex 32
PREVIEW_COOKIE_SECRET=

# --- Studio (only needed if you run or deploy the Studio yourself) ---
# SANITY_STUDIO_PROJECT_ID=krb5nty9
# SANITY_STUDIO_DATASET=production
# SANITY_STUDIO_PREVIEW_URL=https://your-site-address
# SANITY_STUDIO_HOSTNAME=wire-2026
